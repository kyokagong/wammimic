+        if not torch.equal(old['calibration'].cpu(), state['calibration']):
+            raise ValueError('Importance error calibration changed')
+        for key in ('failure_ema','error_ema','visits','episodes','failures'):
+            state[key][:n].copy_(old[key].cpu())
+        refresh_probabilities(state)
+        result['importance_sampling'] = dict(since_iteration=previous['since_iteration'], state=state)
+    return result
