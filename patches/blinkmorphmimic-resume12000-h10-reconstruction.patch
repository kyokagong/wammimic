+def verify_reference_transition(document, manifest_path):
+    """Bind relocated native references and new five-point sidecars to a learned parent."""
+    if Path(document['manifest']['path']).resolve() != Path(manifest_path).resolve():
+        raise ValueError('Reference transition names another manifest')
+    old, new = (_checked(document[k]) for k in ('parent_manifest', 'manifest'))
+    if not old.get('complete') or not new.get('complete'):
+        raise ValueError('Reference transition requires complete datasets')
+    before = {(r['robot'], r['name']): r for r in old['clips']}
+    after = {(r['robot'], r['name']): r for r in new['clips']}
+    if len(before) != len(old['clips']) or len(after) != len(new['clips']):
+        raise ValueError('Duplicate reference transition identity')
+    if set(after) - set(before) != {('q1', 'official_q1_getup')} or not before.keys() <= after.keys():
+        raise ValueError('Only the validated Q1 official reference may be appended')
+    core = ('robot','name','source_id','dataset','split','frames','fps','output_sha256','human_available','human_sha256')
+    for key, row in before.items():
+        current = after[key]
+        if any(row.get(k) != current.get(k) for k in core):
+            raise ValueError('Original native reference or human payload changed')
+        if row.get('human_available'):
+            if current.get('five_point_sha256') != row['human_sha256'] or current.get('five_point_source') != 'original_human':
+                raise ValueError('Original human provenance changed')
+        elif (current.get('five_point_source') != 'robot_reference'
+              or current.get('five_point_provenance',{}).get('reference_sha256') != row['output_sha256']):
+            raise ValueError('Robot reference sidecar lacks its native reference binding')
+    for robot, info in document['robots'].items():
+        for split in ('train','val'):
+            a, b = (_paths(_checked(info[k][split])) for k in ('parent_subsets','subsets'))
+            names_a, names_b = [Path(p).stem for p in a], [Path(p).stem for p in b]
+            appended = ['official_q1_getup'] if robot == 'q1' and split == 'train' else []
+            if names_b != names_a + appended:
+                raise ValueError('Original training/validation order or split changed')
+            expected = {r['name'] for r in new['clips'] if r['robot']==robot and r['split']==split}
+            if len(set(names_b)) != len(names_b) or set(names_b) != expected:
