+++ b/scripts/check_flip_sampling.py
@@ -0,0 +1,22 @@
+"""Check that focused reset branches keep their independent quotas."""
+from types import SimpleNamespace
+
+import torch
+
+from morphmimic.train.recovery import focused_reset_frames
+
+
+def main():
+    torch.manual_seed(19)
+    def window(frame):
+        return torch.tensor([frame]), torch.tensor([frame + 1]), torch.ones(1)
+
+    command = SimpleNamespace(importance_state={}, flip_windows=window(1), flip_rho=.10,
+                              recovery=window(2), recovery_rho=.20)
+    counts = focused_reset_frames(command, torch.zeros(200_000, dtype=torch.long)).bincount()
+    torch.testing.assert_close(counts / counts.sum(), torch.tensor([.72, .08, .20]), atol=.004, rtol=0.)
+    print("Base, flip and recovery reset counts:", counts.tolist())
+
+
+if __name__ == "__main__":
+    main()
