+"""Human input landmarks as world-space debug geoms."""
+
+import numpy as np
+
+FIVE_COLOR = (1.0, 0.58, 0.10, 1.0)
+LINK_COLOR = (1.0, 0.58, 0.10, 0.48)
+
+
+def frame_points(positions, start, steps, hold, origin):
+    """The rendered physics tick, including the final frame and standing hold."""
+    last = len(positions) - 1 if hold is None else hold
+    return positions[min(start + steps, last)] + origin
+
+
+def in_comparison_lane(points, origin, rotation, lane):
+    visible = points.copy()
+    visible[:, :2] = (points[:, :2] - origin) @ rotation.T + lane
+    return visible
+
+
+def draw_five(visualizer, points):
+    valid = np.isfinite(points).all(axis=-1)
+    for index, point in enumerate(points):
+        if not valid[index]:
+            continue
+        if index and valid[0] and np.linalg.norm(point - points[0]) > 1e-6:
+            visualizer.add_cylinder(points[0], point, 0.009, LINK_COLOR)
+        visualizer.add_sphere(point, 0.039 if index == 0 else 0.031, FIVE_COLOR)
