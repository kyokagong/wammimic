+++ b/tests/test_human_five_overlay.py
@@ -0,0 +1,34 @@
+from types import SimpleNamespace
+
+import numpy as np
+
+from preview.human_five import draw_five, frame_points, in_comparison_lane
+
+
+def test_frame_clock_and_lane_use_fixed_reference_transforms():
+    positions = np.arange(90, dtype=float).reshape((6, 5, 3))
+    origin = np.array([1., -2., 0.])
+    np.testing.assert_array_equal(frame_points(positions, 1, 0, None, origin), positions[1] + origin)
+    points = frame_points(positions, 1, 10, 4, origin)
+    np.testing.assert_array_equal(points, positions[4] + origin)
+    rotation = np.array([[0., -1.], [1., 0.]])
+    lane = in_comparison_lane(points, points[0, :2], rotation, np.array([0., 2.]))
+    np.testing.assert_array_equal(lane[0, :2], [0., 2.])
+    np.testing.assert_array_equal(lane[:, 2], points[:, 2])
+    np.testing.assert_array_equal(np.linalg.norm(lane[1:] - lane[0], axis=-1),
+                                  np.linalg.norm(points[1:] - points[0], axis=-1))
+
+
+def test_draw_five_and_skip_unavailable_points():
+    drawn = []
+    lines = []
+    viz = SimpleNamespace(add_sphere=lambda point, *args: drawn.append(point),
+                          add_cylinder=lambda a, b, *args: lines.append((a, b)))
+    points = np.arange(15, dtype=float).reshape((5, 3))
+    draw_five(viz, points)
+    assert len(drawn) == 5 and len(lines) == 4
+    drawn.clear()
+    lines.clear()
+    points[2] = np.nan
+    draw_five(viz, points)
+    assert len(drawn) == 4 and len(lines) == 3
