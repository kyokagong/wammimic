+"""Global + Ref. decoder inputs shared by simulation and imagination."""
+
+import torch
+from mjlab.utils.lab_api.math import quat_apply_inverse, quat_conjugate, quat_mul
+from torch import Tensor
+
+from morphmimic.constants import ROOT_IDX, TRACKED_BODY_NAMES
+from morphmimic.model.state import rot6d_from_quat, split_state
+
+REF_GROUP = "ref_feedback"
+REF_OFFSETS_MS = (0, 20, 40, 60)
+REF_BODIES = ("left_ankle_roll_link", "right_ankle_roll_link",
+              "left_wrist_yaw_link", "right_wrist_yaw_link")
+REF_SLOTS = tuple(TRACKED_BODY_NAMES.index(name) for name in REF_BODIES)
+REF_FRAMES = len(REF_OFFSETS_MS)
+REF_DIM = REF_FRAMES * len(REF_BODIES) * 10
+REF_CONTRACT = {
+    "version": 1,
+    "reference_frame": "fixed_episode_world",
+    "reference_clock": "current_physics_frame",
+    "position_error_frame": "current_pelvis",
+    "rotation_error_frame": "current_end_effector",
+    "rotation_representation": "rot6d_first_two_columns_row_major",
+    "body_order": REF_BODIES,
+    "offsets_ms": REF_OFFSETS_MS,
+    "layout": "4x4x9_errors_then_4x4_validity",
+    "invalid_target": "zero_error_and_clear_validity",
+    "reference_source": "embodiment_retargeted_robot_trajectory",
+}
+
+
+def feedback_frame(library, command_frame: Tensor) -> Tensor:
+    """Native commands aim at the next physics tick, including right after reset."""
+    first = library.clip_start[library.frame_clip[command_frame]]
+    return torch.maximum(command_frame - 1, first)
+
+
+def _end_effectors(values: Tensor) -> Tensor:
+    # Scalar indexing avoids staging a CPU index tensor during CUDA graph capture.
+    return torch.stack([values[..., slot, :] for slot in REF_SLOTS], dim=-2)
+
+
+def global_ref_feedback(state: Tensor, window: Tensor, remaining: Tensor,
+                        target_valid: Tensor | None = None) -> Tensor:
+    """Current and future world targets minus the same current measured FK."""
+    actual = split_state(state)
+    reference = split_state(window[..., :REF_FRAMES, :])
+    pos, quat = _end_effectors(actual.body_pos), _end_effectors(actual.body_quat)
+    ref_pos = _end_effectors(reference.body_pos)
+    ref_quat = _end_effectors(reference.body_quat)
+    pelvis = actual.body_quat[..., ROOT_IDX, :]
+    actual_valid = (pos.isfinite().all(-1) & quat.isfinite().all(-1)
+                    & (quat.square().sum(-1) > 0.5))
+    pelvis_valid = pelvis.isfinite().all(-1) & (pelvis.square().sum(-1) > 0.5)
+    valid = (ref_pos.isfinite().all(-1) & ref_quat.isfinite().all(-1)
+             & (ref_quat.square().sum(-1) > 0.5)
+             & actual_valid.unsqueeze(-2) & pelvis_valid[..., None, None])
+    frames = torch.arange(REF_FRAMES, device=window.device)
+    valid = valid & (frames <= remaining.unsqueeze(-1)).unsqueeze(-1)
+    if target_valid is not None:
+        valid = valid & target_valid
+    # Substitute before quaternion math so padded values have finite gradients.
+    mask = valid.unsqueeze(-1)
+    identity = quat.new_zeros(4)
+    identity[0].fill_(1.)
+    diff = torch.where(mask, ref_pos - pos.unsqueeze(-3), 0.)
+    pelvis = torch.where(pelvis_valid.unsqueeze(-1), pelvis, identity)
+    actual_q = torch.where(mask, quat.unsqueeze(-3), identity)
+    ref_q = torch.where(mask, ref_quat, identity)
+    pos_err = quat_apply_inverse(pelvis[..., None, None, :].expand_as(ref_q), diff)
+    rot_err = rot6d_from_quat(quat_mul(quat_conjugate(actual_q), ref_q))
+    err = torch.where(mask, torch.cat((pos_err, rot_err), dim=-1), 0.)
+    return torch.cat((err.flatten(-3), valid.flatten(-2).to(err.dtype)), dim=-1)
+
+
+def current_ref_valid(feedback: Tensor) -> Tensor:
+    return feedback[..., -REF_FRAMES * len(REF_BODIES):][..., :len(REF_BODIES)].bool().all(-1)
+
+
+def verify_ref_contract(checkpoint: dict) -> bool:
+    enabled = checkpoint["cfg"].get(REF_GROUP, False)
+    if enabled and checkpoint.get(REF_GROUP) != REF_CONTRACT:
+        raise ValueError("Checkpoint has an incompatible Global + Ref. feedback contract")
+    return enabled
