@@ -0,0 +1,85 @@
+"""Numerical contract and main decoder gradient check for Global + Ref."""
+
+import math
+from types import SimpleNamespace
+
+import torch
+
+from morphmimic.constants import GOAL_DIM, HUMAN_GOAL_DIM, PROPRIO_DIM, STATE_DIM
+from morphmimic.model.policy import Policy, PolicyCfg
+from morphmimic.model.ref_feedback import REF_SLOTS, current_ref_valid, feedback_frame, global_ref_feedback
+from morphmimic.model.state import join_state, split_state
+
+
+def main():
+    torch.manual_seed(7)
+    library = SimpleNamespace(clip_start=torch.tensor([0, 5]), frame_clip=torch.arange(10) // 5)
+    torch.testing.assert_close(feedback_frame(library, torch.tensor([1, 5, 6, 9])),
+                               torch.tensor([0, 5, 5, 8]))
+    base = split_state(torch.zeros(1, STATE_DIM))
+    base.body_quat[..., 0] = 1.
+    ref = join_state(base)[:, None].repeat(1, 4, 1)
+    state = join_state(base)
+    limit = torch.tensor([2])
+    feedback = global_ref_feedback(state, ref, limit)
+    data = feedback[:, :144].reshape(1, 4, 4, 9)
+    assert feedback.shape == (1, 160) and current_ref_valid(feedback).item()
+    torch.testing.assert_close(data[0, 0, 0], torch.tensor([0., 0., 0., 1., 0., 0., 1., 0., 0.]))
+    assert not data[:, 3].any() and not feedback[:, -4:].any()
+
+    shift = torch.tensor([0.7, 0., 0.])
+    shifted = join_state(base._replace(body_pos=base.body_pos + shift)).requires_grad_()
+    moved = global_ref_feedback(shifted, ref, limit)
+    points = moved[:, :144].reshape(1, 4, 4, 9)
+    torch.testing.assert_close(points[0, :3, :, :3], -shift.expand(3, 4, 3))
+    both = join_state(base._replace(body_pos=base.body_pos + shift))
+    torch.testing.assert_close(global_ref_feedback(shifted, both[:, None].repeat(1,4,1), limit), feedback)
+
+    rotated = ref.clone()
+    turn = split_state(rotated)
+    turn.body_quat[:, :, REF_SLOTS[0], :] = torch.tensor([math.sqrt(.5), 0., 0., math.sqrt(.5)])
+    qerr = global_ref_feedback(state, rotated, limit)[:, 3:9]
+    torch.testing.assert_close(qerr, torch.tensor([[0., -1., 1., 0., 0., 0.]]), atol=2e-6, rtol=0)
+    valid = torch.ones((1, 4, 4), dtype=torch.bool)
+    valid[:, 0, 0] = False
+    invalid = global_ref_feedback(state, ref, limit, valid)
+
+    if torch.cuda.is_available():
+        current, targets, lengths = (tensor.to("cuda") for tensor in (state, ref, limit))
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            eager = global_ref_feedback(current, targets, lengths)
+        torch.cuda.current_stream().wait_stream(stream)
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph, stream=stream):
+            captured = global_ref_feedback(current, targets, lengths)
+        graph.replay()
+        torch.testing.assert_close(captured.cpu(), eager.cpu())
+        current.copy_(shifted.detach())
+        graph.replay()
+        torch.testing.assert_close(captured.cpu(), moved.detach())
+        print("CUDA graph captures and replays current FK feedback")
+
+    policy = Policy(PolicyCfg(enc_hidden=(32,), dec_hidden=(32,), hist_len=2, human=True, ref_feedback=True))
+    history = torch.zeros(1, PROPRIO_DIM * 2)
+    motion = torch.zeros(1, GOAL_DIM)
+    human = torch.zeros(1, HUMAN_GOAL_DIM)
+    for goal, actor in ((motion, policy), (human, policy.forward_human)):
+        before = actor(history, goal, ref_feedback=feedback)
+        after = actor(history, goal, ref_feedback=moved)
+        delta = (after-before).abs().max()
+        grad, = torch.autograd.grad(after.square().sum(), (shifted,), retain_graph=True)
+        assert delta > 1e-5 and grad.isfinite().all() and grad.abs().max() > 1e-5
+        assert not actor(history, goal, ref_feedback=invalid).isfinite().any()
+        try:
+            actor(history, goal)
+        except ValueError as exc:
+            assert "160D" in str(exc)
+        else:
+            raise AssertionError("Feedback became optional")
+        print(f"Action max delta {delta.item():.6f}, state gradient {grad.abs().max().item():.6f}")
+
+
+if __name__ == "__main__":
+    main()
